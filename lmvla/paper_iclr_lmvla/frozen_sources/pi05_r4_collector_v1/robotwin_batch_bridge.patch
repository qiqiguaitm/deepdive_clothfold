@@ -356,0 +357,33 @@ def _joint_vector(task_env: Any) -> np.ndarray:
+def _save_episode_trajectory(
+    output_dir: Path,
+    episode_id: int,
+    *,
+    actions: list[np.ndarray],
+    states: list[np.ndarray],
+    frame_index: list[int],
+) -> Optional[str]:
+    if len(actions) < 2:
+        return None
+    action_array = np.stack(actions).astype(np.float32, copy=False)
+    state_array = np.stack(states).astype(np.float32, copy=False)
+    frame_array = np.asarray(frame_index, dtype=np.int64)
+    if not (len(action_array) == len(state_array) == len(frame_array)):
+        raise ValueError("trajectory action/state/frame lengths differ")
+    if not np.all(np.diff(frame_array) > 0):
+        raise ValueError("trajectory frame_index must be strictly increasing")
+    if not np.isfinite(action_array).all() or not np.isfinite(state_array).all():
+        raise ValueError("trajectory action/state arrays must be finite")
+
+    output_dir.mkdir(parents=True, exist_ok=True)
+    destination = output_dir / f"episode{episode_id}.npz"
+    temporary = output_dir / f".episode{episode_id}.{os.getpid()}.npz"
+    np.savez_compressed(
+        temporary,
+        actions=action_array,
+        states=state_array,
+        frame_index=frame_array,
+    )
+    temporary.replace(destination)
+    return str(destination)
+
